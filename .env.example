# Copy to .env and fill in. Never commit .env.
PORT=3000
API_URL=https://api.api-ninjas.com/v2/quotes
API_KEY=
# memory (default) or redis. Docker Compose sets redis.
STORE=memory
REDIS_URL=redis://localhost:6379
# inprocess (default) or kafka. Docker Compose sets kafka.
EVENTS=inprocess
KAFKA_BROKERS=localhost:9094
